{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2024"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": false,
		"types": ["node"]
	},
	"include": ["src", "test", "scripts"],
	"exclude": ["src/client", "test/**/*.tsx", "test/client-*.ts", "test/model-color-consistency.test.ts", "test/trace-scale.test.ts", "dist", "node_modules"]
}
